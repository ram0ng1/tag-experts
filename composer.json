{
    "name": "ramon/tag-experts",
    "description": "Recognise the users who know a tag best: expert groups per tag, highlighted expert replies, recommendations and a review queue.",
    "keywords": [
        "flarum",
        "tags",
        "experts",
        "recommendations",
        "reputation"
    ],
    "type": "flarum-extension",
    "license": "MIT",
    "homepage": "https://github.com/ram0ng1/tag-experts",
    "authors": [
        {
            "name": "Ramon Guilherme",
            "email": "ramon@ramonguilherme.com.br",
            "homepage": "https://ramonguilherme.com.br",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/ram0ng1/tag-experts/issues",
        "source": "https://github.com/ram0ng1/tag-experts"
    },
    "require": {
        "php": "^8.3",
        "flarum/core": "^2.0.2",
        "flarum/tags": "^2.0"
    },
    "require-dev": {
        "flarum/approval": "^2.0",
        "flarum/gdpr": "^2.0",
        "flarum/phpstan": "^2.0",
        "flarum/testing": "^2.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5 || ^12.5.22 || ^13.2.0",
        "roave/security-advisories": "dev-latest",
        "vimeo/psalm": "^6.0"
    },
    "autoload": {
        "psr-4": {
            "Ramon\\TagExperts\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ramon\\TagExperts\\Tests\\": "tests/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "Tag Experts",
            "category": "feature",
            "icon": {
                "image": "icon.svg",
                "backgroundColor": "#fff",
                "color": "#fff"
            },
            "optional-dependencies": [
                "flarum/approval",
                "flarum/gdpr"
            ]
        },
        "flarum-cli": {
            "modules": {
                "admin": true,
                "forum": true,
                "js": true,
                "jsCommon": true,
                "css": true,
                "locale": true,
                "typescript": true,
                "backendTesting": true
            }
        }
    },
    "scripts": {
        "analyse:phpstan": "phpstan analyse --memory-limit=2G",
        "clear-cache:phpstan": "phpstan clear-result-cache",
        "test": [
            "@test:unit",
            "@test:integration"
        ],
        "test:unit": "phpunit -c tests/phpunit.unit.xml",
        "test:integration": [
            "Composer\\Config::disableProcessTimeout",
            "phpunit -c tests/phpunit.integration.xml"
        ],
        "test:setup": "@php tests/integration/setup.php"
    },
    "scripts-descriptions": {
        "analyse:phpstan": "Run static analysis",
        "test": "Runs all tests.",
        "test:unit": "Runs all unit tests.",
        "test:integration": "Runs all integration tests.",
        "test:setup": "Sets up a database for use with integration tests. Execute this only once."
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
